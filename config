# 基础外观
font-family = JetBrainsMono Nerd Font
font-size = 13

# U+23F4–U+23FA 媒体控制符号（⏵ ⏸ ⏹ 等）是字体覆盖盲区：JetBrains Mono 和 Nerd Fonts
# 都不含这段，系统里也没有任何字体兜底，会让 Claude Code 的 auto mode / plan mode
# 图标渲染成豆腐块（auto mode 用的是 U+23F5⏵⏵，plan mode 用 U+23F8⏸）。
# 显式指给 Noto Sans Symbols2（装在 ~/.fonts/）。
# 注意 family 名是 "Noto Sans Symbols2"，Symbols 与 2 之间没有空格。
font-codepoint-map = U+23F4-U+23FA=Noto Sans Symbols2

# 窗口配置
background-opacity = 0.92
window-padding-x = 10
window-padding-y = 6
window-width = 100
window-height = 27

# 标签栏配置
gtk-wide-tabs = false
# 光标
cursor-style = block

# 快捷键 & 功能
mouse-hide-while-typing = true

#======================================================
#                     快捷键配置                      #
#======================================================
# 标签栏导航快捷键
keybind = ctrl+shift+h=previous_tab
keybind = ctrl+shift+l=next_tab

# 全屏与最大化
keybind = F11=toggle_fullscreen
keybind = F10=toggle_maximize

# 重命名标题
keybind = ctrl+shift+r=prompt_tab_title

# 创建分屏
# 向右分屏（右边新开）
keybind = ctrl+shift+right=new_split:right
# 向下分屏（下边新开）
keybind = ctrl+shift+down=new_split:down
# 向左分屏（左边新开）
keybind = ctrl+shift+left=new_split:left
# 向上分屏（上边新开）
keybind = ctrl+shift+up=new_split:up

# 聚焦分屏
keybind = ctrl+h=goto_split:left
keybind = ctrl+j=goto_split:down
keybind = ctrl+k=goto_split:up
keybind = ctrl+l=goto_split:right

